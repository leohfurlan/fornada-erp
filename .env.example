# Banco de dados
DATABASE_URL=postgresql+asyncpg://fornada:fornada_dev@localhost:5432/fornada

# Redis (cache e filas Celery)
REDIS_URL=redis://localhost:6379/0

# Segurança JWT
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# IA e OCR
GOOGLE_AI_API_KEY=sua-chave-google-ai-studio-aqui

# Monitoramento
SENTRY_DSN=

# Pagamentos (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ambiente
ENVIRONMENT=development
DEBUG=true

# Frontend
# OPCIONAL. Por padrão o frontend infere a URL do backend automaticamente a
# partir do host do navegador (localhost:3000 → localhost:8000;
# 192.168.x.x:3000 → 192.168.x.x:8000). Defina apenas em cenários onde o
# backend está em outro host (produção, ambientes de CI, etc).
# NEXT_PUBLIC_API_URL=https://api.fornada.app
