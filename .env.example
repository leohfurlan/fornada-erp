# Banco de dados
DATABASE_URL=postgresql+asyncpg://fornada:fornada_dev@localhost:5432/fornada

# Redis (cache e filas Celery)
REDIS_URL=redis://localhost:6379/0

# Segurança JWT
SECRET_KEY=gere-uma-chave-secreta-forte-aqui
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# IA e OCR
GOOGLE_AI_API_KEY=sua-chave-google-ai-studio-aqui
GEMMA_OCR_MODEL=gemma-4-26b-a4b-it
GEMMA_OCR_TEMPERATURE=0.1
GEMMA_OCR_THINKING_LEVEL=minimal
OCR_PROVIDER=gemma
OCR_VISION_PROVIDER=gemma
OPENAI_API_KEY=
OPENAI_OCR_MODEL=

# Conversa WhatsApp (Evolution v2 externa; nunca enviar chaves ao frontend)
WHATSAPP_AUTH_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ENABLED=false
EVOLUTION_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Monitoramento
SENTRY_DSN=

# Monitor iFood experimental (apenas loja de teste; não emite comandos de pedidos)
IFOOD_ENABLED=false
IFOOD_MODE=test
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
IFOOD_TENANT_ID=
IFOOD_TEST_MERCHANT_ID=
IFOOD_TEST_MERCHANT_NAME=
IFOOD_POLL_INTERVAL_SECONDS=30
IFOOD_NOTIFICATIONS_ENABLED=false
IFOOD_NOTIFICATIONS_SINCE=
IFOOD_WHATSAPP_ENABLED=false
IFOOD_WHATSAPP_PHONE=

# Pagamentos (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ambiente
ENVIRONMENT=development
DEBUG=true

# Frontend
# OPCIONAL. Por padrão o frontend infere a URL do backend automaticamente a
# partir do host do navegador (localhost:3000 → localhost:8000;
# 192.168.x.x:3000 → 192.168.x.x:8000). Defina apenas em cenários onde o
# backend está em outro host (produção, ambientes de CI, etc).
# NEXT_PUBLIC_API_URL=https://api.fornada.app

# Integração privada com whatsapp-admin; ativar somente após homologação.
CENTRAL_ENABLED=false
CENTRAL_SERVICE_TOKEN=
CENTRAL_BUSINESS_TENANTS={}
CENTRAL_LOCAL_OCR_ENABLED=false
